flowchart TB
    subgraph INVITE["1 · 发出邀请"]
        direction LR
        A["Owner / Admin<br/>按角色权限提交邀请<br/>勾选授权模型<br/>成员上限选填：留空不单独限额<br/>填写时为 1 至企业上限的整数"] --> B{"手机号、席位<br/>各模型成员上限<br/>校验通过"}
        B -->|失败| C["保留输入<br/>显示错误"]
        B -->|通过| D["创建待接受邀请<br/>仅占用席位 · 不预留并发<br/>发送【模思智能】短信<br/>邀请链接自创建起 1 天（24小时）有效"]
    end

    subgraph LOGIN["2 · 打开短信中的稳定邀请链接"]
        direction LR
        E{"邀请是否有效"} -->|过期或撤销| F["显示失效原因<br/>过期或撤销时释放席位"]
        E -->|有效| G{"是否已登录"}
        G -->|否| H["Mossland 登录<br/>预填受邀手机号<br/>已有账号直接登录<br/>新用户验证手机并同意协议<br/>登录后自动注册"]
        G -->|是| I["进入账号匹配校验"]
        H --> I
    end

    subgraph JOIN["3 · 校验账号并加入企业"]
        direction LR
        J{"登录手机号<br/>与受邀手机号匹配"} -->|否| K["提示换受邀账号<br/>不得加入企业"]
        J -->|是| L{"服务端再次校验<br/>有效期、未撤销<br/>成员关系版本"}
        L -->|失败| M["提示邀请失效<br/>不得加入企业"]
        L -->|通过| N["幂等接受 · 转正常成员<br/>席位转归属 · 不重复占用<br/>成员共享企业各模型并发池"]
        N --> O["回跳平台并提示加入成功<br/>首次登录进入个人页<br/>已登录保留当前页<br/>左下角卡片显示企业选项<br/>用户按需切换企业"]
    end

    subgraph REMOVE["5 · 移除与重新邀请（独立管理操作）"]
        direction LR
        P["正常 / 待接受 / 已过期成员<br/>管理员确认移除"] --> Q["释放仍占用的席位<br/>撤销邀请与企业访问<br/>原企业 Key 永久失效"]
        Q --> R["个人身份与个人 Key 不变<br/>历史费用和用量账本不变"]
        R --> S["同手机号重新邀请<br/>重新校验席位与各模型成员上限<br/>生成新成员版本与新链接<br/>旧链接失效 · 重新走邀请流程<br/>加入后本人创建新企业 Key"]
    end

    INVITE -->|成功发送后| LOGIN
    LOGIN -->|已登录| JOIN
    subgraph CALL["4 · 加入后调用：共享并发资源池"]
        direction LR
        T["正常成员通过有效企业 Key<br/>请求已授权模型"] --> U{"企业并发未达上限<br/>成员未限额或未达上限"}
        U -->|否| V["拒绝新请求"]
        U -->|是| W["原子占用企业与成员并发计数<br/>同一成员多个 Key 合并计数"]
        W --> X["完成、失败、取消或超时<br/>释放本次请求实际占用"]
        Y["各成员上限之和可超过企业上限<br/>未使用容量由企业成员共享<br/>不保证单个成员独占容量"]
    end

    JOIN ~~~ CALL
    CALL ~~~ REMOVE
